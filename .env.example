# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ttrpg

# Transport: "stdio" for local use, "http" for remote deployment
TRANSPORT=stdio

# API Key for protecting HTTP endpoints (optional, recommended for deployment)
API_KEY=your-secret-key-here

# Port for HTTP transport
PORT=3000